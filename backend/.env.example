# Cadena de conexión de Postgres de Supabase (usar el connection pooler, puerto 6543,
# con el service role / postgres user -- este backend necesita bypass de RLS).
# Se obtiene en Supabase > Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.izorrdlcqtrfyckqtpgb.supabase.co:5432/postgres
SUPABASE_URL=https://izorrdlcqtrfyckqtpgb.supabase.co
# Clave pública anon del proyecto; se entrega al navegador mediante /config.js.
SUPABASE_ANON_KEY=

PORT=3001

# Origen permitido para CORS cuando el frontend se sirve por separado.
FRONTEND_ORIGIN=http://localhost:5173

# Cuenta de servicio con acceso de solo lectura a los cuatro archivos de Drive,
# usados únicamente cuando un administrador presiona el botón Actualizar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Habilita el corte mensual interno (kpi_snapshots/vencida_snapshots a las 17:00).
# Mantener false en Render Free; activar solo en una instancia persistente de pago.
IMPORT_SCHEDULER_ENABLED=false
